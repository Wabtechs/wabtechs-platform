generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  avatar    String?
  role      Role     @default(USER)
  bio       String?
  website   String?
  github    String?
  twitter   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts              Post[]
  comments           Comment[]
  likes              Like[]
  bookmarks          Bookmark[]
  auditLogs          AuditLog[]
  enrollments        Enrollment[]
  projectMemberships ProjectMember[]
  ownedProjects      OsProject[]
  assignedFeatures   Feature[]
  assignedBugs       Bug[]
  assignedObjectives Objective[]
  osComments         OsComment[]
  notifications      Notification[]
  mobileAuditLogs    MobileAuditLog[]
  errorLogs          ErrorLog[]
  githubConnection   GithubConnection?
  lessonProgress     LessonProgress[]
  certificates       Certificate[]

  @@map("users")
}

model GithubConnection {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubId    Int
  login       String
  name        String?
  avatarUrl   String?
  accessToken String
  tokenType   String    @default("bearer")
  scope       String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("github_connections")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  readTime    Int       @default(0)
  views       Int       @default(0)
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  metaTitle       String?
  metaDescription String?
  ogImage         String?

  author    User       @relation(fields: [authorId], references: [id])
  tags      Tag[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  @@index([authorId])
  @@index([slug])
  @@map("posts")
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts    Post[]
  podcasts Podcast[]

  @@map("tags")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  postId    String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User      @relation(fields: [authorId], references: [id])
  post    Post      @relation(fields: [postId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  authorId  String
  postId    String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])
  post   Post @relation(fields: [postId], references: [id])

  @@unique([authorId, postId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  authorId  String
  postId    String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([authorId, postId])
  @@map("bookmarks")
}

model Podcast {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  audioUrl    String
  coverImage  String?
  duration    Int
  episode     Int
  season      Int       @default(1)
  published   Boolean   @default(false)
  publishedAt DateTime?

  metaTitle       String?
  metaDescription String?
  ogImage         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags Tag[]

  @@map("podcasts")
}

model Project {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  longDescription String?
  coverImage      String?
  githubUrl       String?
  demoUrl         String?
  techStack       String[]
  featured        Boolean  @default(false)
  archived        Boolean  @default(false)

  language String  @default("TypeScript")
  stars    Int     @default(0)
  forks    Int     @default(0)

  metaTitle       String?
  metaDescription String?
  ogImage         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  token     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("site_settings")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  ip        String?
  userAgent String?
  referer   String?
  country   String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@map("page_views")
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String?
  published       Boolean  @default(false)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pages")
}

model Service {
  id          String @id @default(cuid())
  num         String
  title       String
  description String
  order       Int    @default(0)

  @@map("services")
}

model Skill {
  id      String  @id @default(cuid())
  name    String  @unique
  percent Int     @default(0)
  image   String?
  order   Int     @default(0)

  @@map("skills")
}

model ResumeItem {
  id      String @id @default(cuid())
  years   String
  title   String
  company String
  order   Int    @default(0)

  @@map("resume_items")
}

model PricingPlan {
  id       String   @id @default(cuid())
  name     String
  save     String?
  price    String
  features String[]
  disabled String[]
  featured Boolean  @default(false)
  order    Int      @default(0)

  @@map("pricing_plans")
}

model Testimonial {
  id    String  @id @default(cuid())
  name  String
  role  String?
  text  String
  image String?
  order Int     @default(0)

  @@map("testimonials")
}

model Client {
  id    String  @id @default(cuid())
  name  String
  logo  String?
  url   String?
  order Int     @default(0)

  @@map("clients")
}

model FaqItem {
  id       String  @id @default(cuid())
  question String
  answer   String
  category String?
  order    Int     @default(0)

  @@map("faq_items")
}

model Video {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  videoUrl    String
  thumbnail   String?
  duration    Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("videos")
}

model Tutorial {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  content     String?
  coverImage  String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tutorials")
}

model Snippet {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  language    String?
  code        String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("snippets")
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  url         String?
  type        String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("resources")
}

model Download {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  fileUrl     String
  fileSize    String?
  category    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("downloads")
}

model Roadmap {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  status      String   @default("planned")
  quarter     String?
  year        Int?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roadmaps")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  content     String?
  date        DateTime?
  location    String?
  url         String?
  coverImage  String?
  type        String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("events")
}

model Changelog {
  id        String    @id @default(cuid())
  title     String
  slug      String    @unique
  content   String?
  version   String?
  date      DateTime?
  published Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("changelogs")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ErrorLog {
  id          String   @id @default(cuid())
  message     String
  stack       String?
  code        String?
  statusCode  Int?
  path        String?
  method      String?
  userAgent   String?
  ip          String?
  userId      String?
  context     Json?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([code])
  @@index([path])
  @@index([userId])
  @@map("error_logs")
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  coverImage  String?
  price       Decimal  @default(0)
  level       String   @default("beginner")
  duration    String?
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
  certificates Certificate[]

  @@map("courses")
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  videoUrl    String?
  duration    Int      @default(0)
  order       Int      @default(0)
  content     String?
  free        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([courseId, order])
  @@map("lessons")
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  courseId  String
  watchedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@map("lesson_progress")
}

model Certificate {
  id       String   @id @default(cuid())
  number   String   @unique
  userId   String
  courseId String
  issuedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("certificates")
}

model Template {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String
  longDescription String?
  image           String?
  price           Decimal  @default(0)
  category        String   @default("starter")
  stack           String?
  demoUrl         String?
  repoUrl         String?
  downloadUrl     String?
  downloads       Int      @default(0)
  version         String   @default("1.0.0")
  published       Boolean  @default(false)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("templates")
}

// ============================================================
// PROJECT OS
// ============================================================

enum OsProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  MAINTENANCE
  ARCHIVED
}

enum OsProjectType {
  PLATFORM
  APP
  LIBRARY
  TOOL
  SERVICE
  OTHER
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum FeatureStatus {
  BACKLOG
  PLANNED
  READY
  DEVELOPMENT
  REVIEW
  TESTING
  VALIDATION
  DONE
  RELEASED
  ARCHIVED
}

enum BugStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  FIXED
  VERIFIED
  CLOSED
  WONTFIX
}

enum BugSeverity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ObjectiveStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  DELAYED
  COMPLETED
  CANCELLED
}

model OsProject {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  description   String
  logo          String?
  color         String          @default("#842ae3")
  type          OsProjectType   @default(APP)
  status        OsProjectStatus @default(PLANNING)
  version       String          @default("0.1.0")
  environment   String          @default("development")
  repoUrl       String?
  docsUrl       String?
  websiteUrl    String?
  technologies  String?
  githubStars   Int             @default(0)
  githubForks   Int             @default(0)
  githubIssues  Int             @default(0)
  githubPrs     Int             @default(0)
  githubCommits Int             @default(0)
  healthScore   Int             @default(70)
  mrr           Decimal         @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  members         ProjectMember[]
  epics           Epic[]
  sprints         Sprint[]
  modules         Module[]
  features        Feature[]
  bugs            Bug[]
  objectives      Objective[]
  releases        Release[]
  milestones      Milestone[]
  roadmapItems    RoadmapItem[]
  metricSnapshots MetricSnapshot[]

  @@map("os_projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("DEV")
  createdAt DateTime @default(now())

  project OsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@map("project_members")
}

model Epic {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      FeatureStatus @default(BACKLOG)
  priority    Priority      @default(MEDIUM)
  startDate   DateTime?
  endDate     DateTime?
  progress    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project  OsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features Feature[]

  @@index([projectId])
  @@map("epics")
}

model Module {
  id              String        @id @default(cuid())
  projectId       String
  name            String
  description     String?
  status          FeatureStatus @default(BACKLOG)
  version         String        @default("0.1.0")
  priority        Priority      @default(MEDIUM)
  complexity      String        @default("MEDIUM")
  progress        Int           @default(0)
  documentation   Int           @default(0)
  testCoverage    Int           @default(0)
  qualityScore    Int           @default(0)
  performance     Int           @default(0)
  security        Int           @default(0)
  seo             Int           @default(0)
  accessibility   Int           @default(0)
  maintainability Int           @default(0)
  technicalDebt   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project  OsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features Feature[]

  @@index([projectId])
  @@map("modules")
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)
  velocity  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project  OsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features Feature[]

  @@index([projectId])
  @@map("sprints")
}

model Feature {
  id          String        @id @default(cuid())
  projectId   String
  moduleId    String?
  epicId      String?
  sprintId    String?
  assigneeId  String?
  title       String
  description String?
  priority    Priority      @default(MEDIUM)
  status      FeatureStatus @default(BACKLOG)
  points      Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project  OsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module   Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  epic     Epic?     @relation(fields: [epicId], references: [id], onDelete: SetNull)
  sprint   Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  subtasks Subtask[]
  bugs     Bug[]

  @@index([projectId, status])
  @@index([sprintId])
  @@map("features")
}

model Subtask {
  id        String   @id @default(cuid())
  featureId String
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@index([featureId])
  @@map("subtasks")
}

model Bug {
  id          String      @id @default(cuid())
  projectId   String
  featureId   String?
  assigneeId  String?
  title       String
  description String?
  severity    BugSeverity @default(MAJOR)
  priority    Priority    @default(MEDIUM)
  status      BugStatus   @default(NEW)
  version     String?
  reproduce   String?
  expected    String?
  actual      String?
  fix         String?
  impact      Int         @default(0)
  fixHours    Int         @default(0)
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project  OsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature  Feature?  @relation(fields: [featureId], references: [id], onDelete: SetNull)
  assignee User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@map("bugs")
}

model Objective {
  id          String          @id @default(cuid())
  projectId   String
  assigneeId  String?
  title       String
  description String?
  method      String          @default("OKR")
  target      Decimal         @default(0)
  current     Decimal         @default(0)
  progress    Int             @default(0)
  status      ObjectiveStatus @default(NOT_STARTED)
  deadline    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project    OsProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee   User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  keyResults KeyResult[]

  @@index([projectId])
  @@map("objectives")
}

model KeyResult {
  id          String   @id @default(cuid())
  objectiveId String
  title       String
  current     Decimal  @default(0)
  target      Decimal  @default(0)
  createdAt   DateTime @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
  @@map("key_results")
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  date        DateTime?
  status      String    @default("PLANNED")
  createdAt   DateTime  @default(now())

  project OsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

model Release {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  version     String
  description String?
  status      String    @default("PLANNED")
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project OsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("releases")
}

model RoadmapItem {
  id             String    @id @default(cuid())
  projectId      String
  title          String
  description    String?
  type           String    @default("EPIC")
  status         String    @default("PLANNED")
  priority       Priority  @default(MEDIUM)
  progress       Int       @default(0)
  startDate      DateTime?
  endDate        DateTime?
  estimatedHours Int       @default(0)
  actualHours    Int       @default(0)
  roi            Int       @default(0)
  impact         Int       @default(0)
  dependencies   String?
  risks          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project OsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("roadmap_items")
}

model OsComment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  userId     String?
  content    String
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("os_comments")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model MetricSnapshot {
  id        String   @id @default(cuid())
  projectId String?
  metric    String
  value     Float    @default(0)
  date      DateTime @default(now())

  project OsProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([metric, date])
  @@map("metric_snapshots")
}

// ============================================================
// MOBILE APP BUILDER
// ============================================================

enum MobileFramework {
  NEXT_JS
  REACT_NATIVE
  EXPO
  VUE
  SVELTEKIT
  CUSTOM
}

enum PlatformTarget {
  ANDROID
  IOS
  BOTH
}

enum BuildStatus {
  PENDING
  BUILDING
  SUCCESS
  FAILED
}

enum ReleaseStatus {
  DRAFT
  INTERNAL_TESTING
  BETA
  PRODUCTION
}

model MobileApp {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  packageName     String           @unique
  bundleId        String           @unique
  description     String?
  icon            String?
  splashScreen    String?
  repositoryUrl   String
  framework       MobileFramework  @default(NEXT_JS)
  version         String           @default("1.0.0")
  status          BuildStatus      @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  builds          MobileBuild[]
  certificates    MobileCertificate[]
  releases        MobileRelease[]
  storeIntegrations StoreIntegration[]
  auditLogs       MobileAuditLog[]

  @@index([slug])
  @@map("mobile_apps")
}

model MobileBuild {
  id           String       @id @default(cuid())
  appId        String
  platform     PlatformTarget
  version      String
  status       BuildStatus  @default(PENDING)
  logs         String?
  artifactUrl  String?
  duration     Int?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  app          MobileApp    @relation(fields: [appId], references: [id], onDelete: Cascade)
  releases     MobileRelease[]

  @@index([appId])
  @@index([status])
  @@map("mobile_builds")
}

model MobileCertificate {
  id             String           @id @default(cuid())
  appId          String
  provider       String           // "android-keystore" | "apple-certificate"
  name           String
  encryptedSecret String          // AES-256-GCM encrypted
  status         String           @default("active") // active, expired, revoked
  createdAt      DateTime         @default(now())
  expiresAt      DateTime?

  app            MobileApp        @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@map("mobile_certificates")
}

model MobileRelease {
  id          String         @id @default(cuid())
  appId       String
  version     String
  status      ReleaseStatus  @default(DRAFT)
  changelog   String?
  buildId     String?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())

  app         MobileApp      @relation(fields: [appId], references: [id], onDelete: Cascade)
  build       MobileBuild?   @relation(fields: [buildId], references: [id], onDelete: SetNull)

  @@index([appId])
  @@index([status])
  @@map("mobile_releases")
}

model StoreIntegration {
  id          String    @id @default(cuid())
  appId       String
  provider    String    // "google-play" | "app-store"
  credentials String    // encrypted
  status      String    @default("disconnected") // connected, disconnected, error
  lastSync    DateTime?
  createdAt   DateTime  @default(now())

  app         MobileApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@map("store_integrations")
}

model MobileAuditLog {
  id          String   @id @default(cuid())
  appId       String
  action      String   // BUILD_STARTED, BUILD_COMPLETED, APP_RELEASED, CERTIFICATE_UPDATED, APP_CREATED, APP_UPDATED
  userId      String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  app        MobileApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([appId])
  @@index([action])
  @@map("mobile_audit_logs")
}

