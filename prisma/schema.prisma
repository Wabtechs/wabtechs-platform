generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  avatar    String?
  role      Role     @default(USER)
  bio       String?
  website   String?
  github    String?
  twitter   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts        Post[]
  comments     Comment[]
  likes        Like[]
  bookmarks    Bookmark[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model Post {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String
  content     String
  coverImage  String?
  published   Boolean     @default(false)
  featured    Boolean     @default(false)
  readTime    Int         @default(0)
  views       Int         @default(0)
  authorId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?

  author   User        @relation(fields: [authorId], references: [id])
  tags     Tag[]
  comments Comment[]
  likes    Like[]

  @@index([authorId])
  @@index([slug])
  @@map("posts")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique

  posts     Post[]
  podcasts  Podcast[]

  @@map("tags")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  postId    String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User       @relation(fields: [authorId], references: [id])
  post     Post       @relation(fields: [postId], references: [id])
  parent   Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[]  @relation("CommentReplies")

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  authorId  String
  postId    String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])
  post   Post @relation(fields: [postId], references: [id])

  @@unique([authorId, postId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  authorId  String
  postId    String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])

  @@unique([authorId, postId])
  @@map("bookmarks")
}

model Podcast {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  audioUrl    String
  coverImage  String?
  duration    Int
  episode     Int
  season      Int      @default(1)
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags Tag[]

  @@map("podcasts")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  longDescription String?
  coverImage  String?
  githubUrl   String?
  demoUrl     String?
  techStack   String[]
  featured    Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  token     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
